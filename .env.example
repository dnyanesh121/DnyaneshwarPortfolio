# MongoDB Atlas connection string (optional).
# Copy this file to `.env.local` and fill in your URI to enable the contact form storage.
# Without it, the form still works in "demo mode" and returns a success response,
# but messages are not persisted.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=portfolio
